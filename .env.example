# Copy this file to .env.local and adjust values for local development.
# Never commit real secrets. Server-only variables must never be prefixed with
# VITE_ (exposing them to the client bundle).

# App title shown in the browser title bar (client-visible, VITE_ prefix).
VITE_APP_TITLE=SharedSpace

# Canonical public URL of the deployment (server-only).
# SERVER_URL=https://sharedspace.example.com

# PostgreSQL connection string. Local dev uses the docker-compose.yml Postgres.
# For production use a managed provider such as Neon.
DATABASE_URL=postgresql://sharedspace:sharedspace@localhost:5432/sharedspace

# Clerk authentication (see https://dashboard.clerk.com/).
# Publishable key is public (client). Secret key is server-only.
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...
